/* 2026-04-22 - Custom pin mapping for LED candle by Claude
 * 2026-04-26 - Added battery ADC on P0.29 (AIN5) with 2M+1M divider (Claude)
 * Candle LED: P1.11 (GPIO 1.11) via PWM0 ch0 - confirmed working
 * Pairing button: P0.31 (GPIO 0.31), active low with pull-up
 */

#include <zephyr/dt-bindings/adc/nrf-adc.h>

/ {
	pwmleds {
		compatible = "pwm-leds";
		candle_pwm: candle_pwm {
			pwms = <&pwm0 0 PWM_USEC(10000) PWM_POLARITY_INVERTED>;
		};
	};

	buttons {
		compatible = "gpio-keys";
		pairing_button: pairing_button {
			gpios = <&gpio0 31 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Pairing button";
		};
	};

	chosen {
		ncs,zigbee-timer = &timer2;
	};

	/* Battery voltage divider: 2M upper + 1M lower, P0.29 (AIN5) */
	battery: battery {
		compatible = "voltage-divider";
		io-channels = <&adc 5>;
		output-ohms = <1000000>;
		full-ohms = <3000000>;
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_candle_default>;
	pinctrl-1 = <&pwm0_candle_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	pwm0_candle_default: pwm0_candle_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
		};
	};
	pwm0_candle_sleep: pwm0_candle_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
			low-power-enable;
		};
	};
};

&timer2 {
	status = "okay";
};

/* Battery voltage on P0.29 (AIN5), 2M+1M resistor divider */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;
		zephyr,resolution = <12>;
	};
};
